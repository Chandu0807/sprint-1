# Copy to backend/.env for the local demo. SQLite needs no separate database service.
DATABASE_URL=sqlite:///./microfinance.db

# For PostgreSQL, replace the SQLite URL with a configured PostgreSQL URL.
# DATABASE_URL=postgresql+psycopg2://mf_user:mf_pass@localhost:5432/microfinance

SECRET_KEY=change-this-to-a-long-random-string
TOKEN_HOURS=8
CORS_ORIGINS=http://localhost:8501,http://localhost:5173
